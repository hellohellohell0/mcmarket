generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id                String        @id @default(uuid())
  username          String
  description       String
  priceCurrentOffer Float?
  priceBin          Float?
  createdAt         DateTime      @default(now())
  accountTypes      String        @default("OG")
  nameChanges       Int           @default(0)
  publicContact     String        @default("Contact Admin")
  sellerDiscordId   String        @default("N/A")
  sellerName        String        @default("Legacy User")
  status            ListingStatus @default(APPROVED)
  currentOwnerName  String        @default("Verified Owner")
  isVerifiedOwner   Boolean       @default(false)
  oguProfileUrl     String?
  contactDiscord    String?
  contactTelegram   String?
  ticketNumber      String?
  identityVerified  Boolean       @default(false)
  currency          String        @default("USD")
  isPinned          Boolean       @default(false)
  pinOrder          Int           @default(0)
  hideIgn           Boolean       @default(false)
  capes             Cape[]
}

model Cape {
  id        String  @id @default(uuid())
  name      String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model RequestLog {
  id        String   @id @default(uuid())
  ip        String
  endpoint  String   @default("submission")
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}
